name: 03 - Auto-merge PR

on:
  pull_request:
    types: [opened, reopened, synchronize] # Detects when PRs are opened or updated

permissions:
  pull-requests: write # Required to approve and merge PRs
  contents: write      # Required to write changes to the repository

jobs:
  auto-merge:
    runs-on: ubuntu-latest
    # Optional: Filter for specific branches or users (e.g., dependabot)
    # if: github.actor == 'dependabot[bot]' 
    
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Auto-approve PR
        # Optional: Pull requests usually require an approval before they can be merged.
        # This step uses the GitHub CLI to automatically approve the opened PR.
        run: gh pr review "${{ github.event.pull_request.html_url }}" --approve
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Enable GitHub Auto-Merge
        # This flags the PR to merge automatically as soon as status checks pass.
        # Options for --merge-method: merge, squash, rebase
        run: gh pr merge "${{ github.event.pull_request.html_url }}" --auto --squash
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

